diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f102b56..9698e40 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -245,8 +245,16 @@ target_compile_options(imgui PRIVATE -w)
 # SDL3 - Cross-platform media layer
 #=============================================================================
 set(SDL_INSTALL ON CACHE BOOL "" FORCE)
-set(SDL_SHARED OFF CACHE BOOL "" FORCE)
-set(SDL_STATIC ON CACHE BOOL "" FORCE)
+# ITC (patches/rexglue-sdk/0003-itc-windows-sdl-dll.patch): on Windows, SDL
+# is a DLL, so the game and rexruntime.dll share one SDL (a static SDL is
+# linked into each, as a DLL only exports its own code).
+if(WIN32)
+    set(SDL_SHARED ON CACHE BOOL "" FORCE)
+    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
+else()
+    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+    set(SDL_STATIC ON CACHE BOOL "" FORCE)
+endif()
 set(SDL_TEST OFF CACHE BOOL "" FORCE)
 set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
 
@@ -261,7 +269,9 @@ else()
     set(SDL_METAL OFF CACHE BOOL "" FORCE)
     # Linux picks X11 or Wayland at runtime, so the surface has to come from
     # whichever driver SDL chose. Windows presenters go straight from the HWND.
-    if(UNIX)
+    # ITC (0003): the game's own renderer makes its Vulkan surface through
+    # SDL on Windows too.
+    if(UNIX OR WIN32)
         set(SDL_VULKAN ON CACHE BOOL "" FORCE)
     else()
         set(SDL_VULKAN OFF CACHE BOOL "" FORCE)
